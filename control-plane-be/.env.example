# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/controlplane

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Object Storage (MinIO / S3-compatible)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000
AWS_BUCKET_NAME=controlplane
AWS_REGION=us-east-1

# App
APP_ENV=development
MAX_UPLOAD_SIZE_MB=50

# Seed — default admin (change before first deploy)
ADMIN_EMAIL=haval_admin@haval.com
ADMIN_PASSWORD=ChangeMe123!

# Maintenance module
MAINTENANCE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/maintenance_db
MAINTENANCE_JWT_SECRET=change-this-maintenance-secret-in-production
MAINTENANCE_ADMIN_EMAIL=maintenance_admin@haval.com
MAINTENANCE_ADMIN_PASSWORD=ChangeMe123!
MAINTENANCE_ADMIN_NAME=Maintenance Admin
